# Copy this file to `.env` (same folder) and fill in what you need.
# The server loads it automatically on start. Real shell env vars still win.

# --- Vani Autopilot + AI assistant ------------------------------------
# Required for the AUTOPILOT tab (the autonomous phone-use agent) and the
# Vani chat tab. Get a FREE key at https://aistudio.google.com/apikey .
# Without it both show "disabled"; the rest of NexusFlow works normally.
GEMINI_API_KEY=

# Model for the agent and the assistant (default: gemini-3.8-flash — Google's
# Flash model aimed at long-horizon agentic work, available on the free tier).
# NEXUSFLOW_AI_MODEL=gemini-3.8-flash

# Provider: "gemini" (default) or "mock".
#   mock = scripted decisions, no API key, no network, no quota. The phone is
#   still driven for real — only the model's choices are canned. Use it to
#   rehearse a demo, or as a fallback if the API is unreachable.
# NEXUSFLOW_AI_PROVIDER=mock

# --- Remote / LAN access (optional) ----------------------------------
# Set a long random string to allow access from other machines with
# `Authorization: Bearer <token>` (and `?token=` on the WebSocket).
# Leave empty for localhost-only mode.
NEXUSFLOW_AUTH_TOKEN=

# Comma-separated browser origins allowed to open the WebSocket
# (only needed with NEXUSFLOW_AUTH_TOKEN set and a non-localhost origin).
# NEXUSFLOW_ALLOWED_ORIGINS=http://localhost:3000

# --- Misc ----------------------------------------------------------------
# PORT=3000
# NEXUSFLOW_NO_BROWSER=1   # don't auto-launch Chrome on start
